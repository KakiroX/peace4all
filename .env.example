# Firebase web app config (Firebase console → Project settings → Your apps → Web app).
# These are public values; access is protected by firestore.rules.
# Leave them unset to run the app in local-only mode (no sign-in, progress stays in the browser).
NEXT_PUBLIC_FIREBASE_API_KEY=
NEXT_PUBLIC_FIREBASE_AUTH_DOMAIN=
NEXT_PUBLIC_FIREBASE_PROJECT_ID=
NEXT_PUBLIC_FIREBASE_APP_ID=
NEXT_PUBLIC_FIREBASE_STORAGE_BUCKET=
NEXT_PUBLIC_FIREBASE_MESSAGING_SENDER_ID=

# Local development against the Firebase emulators (npm run emulators):
# NEXT_PUBLIC_FIREBASE_API_KEY=demo-key
# NEXT_PUBLIC_FIREBASE_AUTH_DOMAIN=demo-ibgrind.firebaseapp.com
# NEXT_PUBLIC_FIREBASE_PROJECT_ID=demo-ibgrind
# NEXT_PUBLIC_FIREBASE_APP_ID=1:000000000000:web:demo
# NEXT_PUBLIC_FIREBASE_EMULATORS=1
