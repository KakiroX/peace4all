rules_version = '2';

// IB Grind: every learner can read and write only their own documents.
//   users/{uid}             profile: settings, reset markers, familiarization test results
//   users/{uid}/days/{day}  answers for one calendar day
service cloud.firestore {
  match /databases/{database}/documents {
    function isOwner(uid) {
      return request.auth != null && request.auth.uid == uid;
    }

    match /users/{uid} {
      allow read, write: if isOwner(uid);

      match /days/{day} {
        allow read, delete: if isOwner(uid);
        allow create, update: if isOwner(uid)
          && day.matches('^[0-9]{4}-[0-9]{2}-[0-9]{2}$')
          && request.resource.data.keys().hasOnly(['attempts'])
          && request.resource.data.attempts is list;
      }
    }

    // Everything else is closed.
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
